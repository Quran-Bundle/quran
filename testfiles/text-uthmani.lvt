\documentclass{article}
\input{regression-test}
\usepackage[uthmani]{quran}
\makeatletter
\begin{document}
\START
\TEST{uthmani database has 6236 ayahs}{%
  \ASSERT{\ifcsname qurantext@mmmmmmccxxxvi\endcsname Y\else N\fi}{Y}%
  \ASSERT{\ifcsname qurantext@mmmmmmccxxxvii\endcsname Y\else N\fi}{N}%
}
\TEST{uthmani differs from the simple text}{%
  \qt@qurantexttrue
  \edef\t{\csname qurantext@mmmmmmccxxxv\endcsname}\edef\t{\detokenize\expandafter{\t}}%
  \IfSubStr{\t}{\detokenize{ٱ}}{\typeout{has alef wasla}}{\typeout{no alef wasla}}%
}
\END
