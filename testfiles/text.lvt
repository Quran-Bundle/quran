\documentclass{article}
\input{regression-test}
\usepackage{quran}
\makeatletter
\begin{document}
\START
\TEST{text database has 6236 ayahs}{%
  \ASSERT{\ifcsname qurantext@mmmmmmccxxxvi\endcsname Y\else N\fi}{Y}%
  \ASSERT{\ifcsname qurantext@mmmmmmccxxxvii\endcsname Y\else N\fi}{N}%
}
\TEST{first and last ayah}{%
  \edef\first{\csname qurantext@i\endcsname}%
  \edef\last{\csname qurantext@mmmmmmccxxxvi\endcsname}%
  \typeout{[\detokenize\expandafter{\first}]}%
  \typeout{[\detokenize\expandafter{\last}]}%
}
\END
